{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OBD2 Dash",
  "version": "0.1.0",
  "identifier": "com.haullogic.obd2dash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OBD2 Dash",
        "width": 1440,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
